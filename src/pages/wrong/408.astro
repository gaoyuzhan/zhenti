---
import ReaderLayout from '../../layouts/ReaderLayout.astro';
import '../../styles/wrong-book.css';
import '../../styles/choice-practice.css';
const siteBase = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<ReaderLayout title="408 错题集 · 知间" description="只显示你在 408 真题中标记为错题的题目。">
  <main class="wrong-book" data-408-wrong-book data-site-base={siteBase}>
    <div class="wrong-shell">
      <aside class="wrong-sidebar" aria-label="408 错题目录">
        <div class="wrong-sidebar-inner">
          <h2>目录</h2>
          <a href={`${siteBase}/408/`}>返回 408 真题 <span>套卷</span></a>
          <p class="wrong-nav-label">错题年份</p>
          <nav class="wrong-year-nav" data-wrong-year-nav></nav>
        </div>
      </aside>

      <section class="wrong-content">
        <header class="wrong-header">
          <a class="wrong-back" href={`${siteBase}/`}>← 返回知间</a>
          <h1>408 错题集</h1>
          <p>点选 A/B/C/D 后立即判对错；复习时再次答错的题进入“二重错题”。每次打开错题集，答案都先隐藏。</p>
          <div class="wrong-summary"><span data-wrong-count>正在读取错题…</span><span>记录只保存在当前浏览器；判卷同步错题会自动导入</span></div>
          <div class="wrong-view-switch" role="group" aria-label="错题复习轮次">
            <button type="button" data-view-all>全部错题 <span data-count-all>0</span></button>
            <button type="button" data-view-repeat>二重错题 <span data-count-repeat>0</span></button>
          </div>
        </header>
        <div class="wrong-list" data-wrong-list></div>
        <div class="wrong-empty" data-wrong-empty hidden>
          还没有 408 错题。<br />回到 408 真题页，把需要复盘的题标记为“错题”即可。
        </div>
      </section>
    </div>
  </main>

  <script>
    // @ts-nocheck
    import { getVerified408ChoiceAnswer } from '../../data/408-answer-key';
    import { assistant408WrongBatches } from '../../data/assistant-wrong-batches';
    import { createChoicePractice, readPracticeIds, savePracticeIds } from '../../lib/choice-practice';

    const DATA_SOURCES = [
      'data-structure',
      'computer-organization',
      'operating-system',
      'computer-network'
    ];
    const RAW_BASE = 'https://raw.githubusercontent.com/zhaoyang51/cs408-notes/main/docs/public/data/practice';
    const PAGES_BASE = 'https://zhaoyang51.github.io/cs408-notes/data/practice';
    const storageKey = 'zhijian-408-wrong';
    const assistantBatchStorageKey = 'zhijian-408-assistant-batches';
    const repeatStorageKey = 'zhijian-408-repeat-wrong';
    const reviewStorageKey = 'zhijian-408-review-answers';

    const root = document.querySelector('[data-408-wrong-book]');
    const siteBase = root?.dataset.siteBase ?? '';
    const assetBase = `${siteBase}/408-assets/figures`;
    const list = root?.querySelector('[data-wrong-list]');
    const empty = root?.querySelector('[data-wrong-empty]');
    const count = root?.querySelector('[data-wrong-count]');
    const yearNav = root?.querySelector('[data-wrong-year-nav]');
    const allButton = root?.querySelector('[data-view-all]');
    const repeatButton = root?.querySelector('[data-view-repeat]');
    const allCount = root?.querySelector('[data-count-all]');
    const repeatCount = root?.querySelector('[data-count-repeat]');
    let viewMode = new URLSearchParams(window.location.search).get('tier') === '2' ? 'repeat' : 'all';

    const readWrong = () => {
      try {
        const value = JSON.parse(localStorage.getItem(storageKey) || '[]');
        return new Set(Array.isArray(value) ? value.map(Number).filter(Number.isFinite) : []);
      } catch {
        return new Set();
      }
    };

    const saveWrong = (set) => {
      try { localStorage.setItem(storageKey, JSON.stringify([...set])); } catch {}
    };

    const readProcessedBatches = () => {
      try {
        const value = JSON.parse(localStorage.getItem(assistantBatchStorageKey) || '[]');
        return new Set(Array.isArray(value) ? value.filter((item) => typeof item === 'string') : []);
      } catch {
        return new Set();
      }
    };

    const saveProcessedBatches = (set) => {
      try { localStorage.setItem(assistantBatchStorageKey, JSON.stringify([...set])); } catch {}
    };

    async function fetchJson(name) {
      for (const url of [`${RAW_BASE}/${name}.json`, `${PAGES_BASE}/${name}.json`]) {
        try {
          const response = await fetch(url, { cache: 'force-cache' });
          if (response.ok) return await response.json();
        } catch {}
      }
      return [];
    }

    async function fetchManifest() {
      try {
        const response = await fetch(`${assetBase}/manifest.json`, { cache: 'force-cache' });
        return response.ok ? await response.json() : {};
      } catch {
        return {};
      }
    }

    function appendTextWithCode(target, value) {
      const text = String(value || '');
      const regex = /\`\`\`([^\n]*)\n?([\s\S]*?)\`\`\`/g;
      let cursor = 0;
      let match;
      while ((match = regex.exec(text))) {
        const before = text.slice(cursor, match.index);
        if (before) {
          const block = document.createElement('div');
          block.style.whiteSpace = 'pre-wrap';
          block.textContent = before.trim();
          if (block.textContent) target.append(block);
        }
        const pre = document.createElement('pre');
        const code = document.createElement('code');
        code.textContent = match[2].trimEnd();
        pre.append(code);
        target.append(pre);
        cursor = regex.lastIndex;
      }
      const tail = text.slice(cursor);
      if (tail) {
        const block = document.createElement('div');
        block.style.whiteSpace = 'pre-wrap';
        block.textContent = tail.trim();
        if (block.textContent) target.append(block);
      }
    }

    function normalize(question) {
      const qIndex = Number(question.qIndex);
      const year = Number(question.year);
      return {
        ...question,
        id: Number(question.id),
        qIndex,
        year,
        examType: qIndex >= 41 ? 'comprehensive' : 'choice',
        answer: qIndex <= 40 ? getVerified408ChoiceAnswer(year, qIndex) : ''
      };
    }

    function renderQuestion(question, manifest, wrongSet, section, onRemove, onGraded) {
      const article = document.createElement('article');
      article.className = 'wrong-question';

      const head = document.createElement('div');
      head.className = 'wrong-question-head';
      const h3 = document.createElement('h3');
      h3.textContent = `第 ${question.qIndex} 题`;

      const actions = document.createElement('div');
      actions.className = 'wrong-question-actions';
      const source = document.createElement('a');
      source.href = `${siteBase}/408/#q-${question.id}`;
      source.textContent = '回原题';
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.textContent = '移出错题';
      remove.addEventListener('click', () => {
        wrongSet.delete(question.id);
        saveWrong(wrongSet);
        const repeat = readPracticeIds(repeatStorageKey);
        repeat.delete(question.id);
        savePracticeIds(repeatStorageKey, repeat);
        onRemove();
      });
      actions.append(source, remove);
      head.append(h3, actions);
      article.append(head);

      const body = document.createElement('div');
      body.className = 'wrong-question-body';
      appendTextWithCode(body, question.stem);
      article.append(body);

      const figurePath = manifest[`${question.year}-${question.qIndex}`];
      if (figurePath) {
        const figure = document.createElement('figure');
        figure.className = 'wrong-source-figure';
        const image = document.createElement('img');
        image.src = `${assetBase}/${figurePath}`;
        image.alt = `${question.year} 年 408 第 ${question.qIndex} 题原卷题面（含图）`;
        image.loading = 'lazy';
        figure.append(image);
        article.append(figure);
      }

      if (question.examType === 'choice' && Array.isArray(question.options) && question.options.length) {
        article.append(createChoicePractice({
          id: question.id,
          answer: question.answer,
          answerStorageKey: reviewStorageKey,
          wrongStorageKey: storageKey,
          repeatStorageKey,
          resetOnLoad: true,
          layout: 'rows',
          options: question.options.map((option) => ({
            label: option.label,
            renderContent: (target) => appendTextWithCode(target, option.text)
          })),
          onGraded: (correct) => {
            if (correct === false) wrongSet.add(question.id);
            onGraded();
          }
        }));
      } else {
        const info = document.createElement('p');
        info.className = 'wrong-answer-status';
        info.textContent = '综合应用题暂不支持自动判分；请在纸上完成，再回原题复盘。';
        article.append(info);
      }
      section.append(article);
    }

    async function load() {
      list?.replaceChildren();
      yearNav?.replaceChildren();

      const [datasets, manifest] = await Promise.all([
        Promise.all(DATA_SOURCES.map(fetchJson)),
        fetchManifest()
      ]);
      const allQuestions = datasets.flat().map(normalize);
      const wrongSet = readWrong();
      const processed = readProcessedBatches();
      const pending = assistant408WrongBatches.filter((batch) => !processed.has(batch.id));

      pending.forEach((batch) => {
        let complete = true;
        batch.items.forEach((item) => {
          const question = allQuestions.find((candidate) =>
            candidate.year === item.year && candidate.qIndex === item.question
          );
          if (!question) {
            complete = false;
            return;
          }
          wrongSet.add(question.id);
        });
        if (complete) processed.add(batch.id);
      });

      if (pending.length) {
        saveWrong(wrongSet);
        saveProcessedBatches(processed);
      }

      const questions = allQuestions
        .filter((question) => wrongSet.has(question.id))
        .sort((a, b) => a.year - b.year || a.qIndex - b.qIndex);

      const updateCounters = () => {
        const repeat = readPracticeIds(repeatStorageKey);
        const repeatTotal = questions.filter((question) => wrongSet.has(question.id) && repeat.has(question.id)).length;
        const allTotal = questions.filter((question) => wrongSet.has(question.id)).length;
        if (allCount) allCount.textContent = String(allTotal);
        if (repeatCount) repeatCount.textContent = String(repeatTotal);
        if (count) count.textContent = viewMode === 'repeat'
          ? '二重错题共 ' + repeatTotal + ' 道' : '共 ' + allTotal + ' 道错题';
        allButton?.classList.toggle('is-active', viewMode === 'all');
        repeatButton?.classList.toggle('is-active', viewMode === 'repeat');
        allButton?.setAttribute('aria-pressed', String(viewMode === 'all'));
        repeatButton?.setAttribute('aria-pressed', String(viewMode === 'repeat'));
      };

      const renderView = () => {
        list?.replaceChildren();
        yearNav?.replaceChildren();
        const repeated = readPracticeIds(repeatStorageKey);
        const visible = questions.filter((question) =>
          wrongSet.has(question.id) && (viewMode === 'all' || repeated.has(question.id))
        );
        updateCounters();
        if (empty) {
          empty.hidden = visible.length > 0;
          empty.textContent = viewMode === 'repeat'
            ? '还没有二重错题。已经进入错题集的选择题，在复习中再次答错后会自动出现在这里。'
            : '还没有 408 错题。回到 408 真题页作答或手动标记错题即可。';
        }
        if (!visible.length || !list || !yearNav) return;
        const years = [...new Set(visible.map((question) => question.year))].sort((a, b) => a - b);
        const sections = new Map();
        years.forEach((year, index) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'wrong-year-button';
          button.dataset.year = String(year);
          button.textContent = String(year);
          if (index === 0) button.classList.add('is-active');
          button.addEventListener('click', () => {
            yearNav.querySelectorAll('.wrong-year-button').forEach((item) => item.classList.toggle('is-active', item === button));
            sections.get(year)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          yearNav.append(button);
          const section = document.createElement('section');
          section.className = 'wrong-year-section';
          const h2 = document.createElement('h2');
          h2.className = 'wrong-year-heading';
          h2.textContent = String(year) + ' 年';
          section.append(h2);
          sections.set(year, section);
          list.append(section);
        });
        visible.forEach((question) =>
          renderQuestion(question, manifest, wrongSet, sections.get(question.year), renderView, updateCounters)
        );
      };

      const changeView = (next) => {
        viewMode = next;
        const url = new URL(window.location.href);
        if (next === 'repeat') url.searchParams.set('tier', '2');
        else url.searchParams.delete('tier');
        window.history.replaceState(null, '', url);
        renderView();
      };
      allButton?.addEventListener('click', () => changeView('all'));
      repeatButton?.addEventListener('click', () => changeView('repeat'));
      renderView();
    }

    void load();
  </script>
</ReaderLayout>
