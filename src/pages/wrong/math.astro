---
import ReaderLayout from '../../layouts/ReaderLayout.astro';
import '../../styles/wrong-book.css';
import '../../styles/choice-practice.css';
const siteBase = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<ReaderLayout title="数学二错题集 · 知间" description="只显示你在数学二真题中加入错题集的题目。">
  <main class="wrong-book" data-math-wrong-book data-site-base={siteBase}>
    <div class="wrong-shell">
      <aside class="wrong-sidebar" aria-label="数学二错题目录">
        <div class="wrong-sidebar-inner">
          <h2>目录</h2>
          <a href={`${siteBase}/books/math-two-exams/`}>返回数学二真题 <span>套卷</span></a>
          <p class="wrong-nav-label">错题年份</p>
          <nav class="wrong-year-nav" data-wrong-year-nav></nav>
        </div>
      </aside>

      <section class="wrong-content">
        <header class="wrong-header">
          <a class="wrong-back" href={`${siteBase}/`}>← 返回知间</a>
          <h1>数学二错题集</h1>
          <p>选择题直接点选并自动判分；填空题和解答题先查看参考答案，再用 ✓ / ✗ 自评。所有答题结果刷新后保留，再错自动进入二重错题。</p>
          <div class="wrong-summary"><span data-wrong-count>正在读取错题…</span><span>记录保存在当前浏览器；判卷同步错题会自动导入</span></div>
          <div class="wrong-view-switch" role="group" aria-label="错题复习轮次">
            <button type="button" data-view-all>全部错题 <span data-count-all>0</span></button>
            <button type="button" data-view-repeat>二重错题 <span data-count-repeat>0</span></button>
          </div>
        </header>
        <div class="wrong-list" data-wrong-list></div>
        <div class="wrong-empty" data-wrong-empty hidden>
          还没有数学二错题。<br />回到任意数学二套卷，在题号右侧点“加入错题”即可。
        </div>
      </section>
    </div>
  </main>

  <script>
    import { assistantMathTwoWrongBatches } from '../../data/assistant-wrong-batches';
    import { getMathTwoChoiceAnswer } from '../../data/math-two-answer-key';
    import { getMathTwoWrittenAnswerReference } from '../../data/math-two-written-answers';
    import { createSubjectivePractice } from '../../lib/subjective-practice';
    import { createChoicePractice, findMathChoiceEnd, readPracticeIds, savePracticeIds } from '../../lib/choice-practice';

    const root = document.querySelector<HTMLElement>('[data-math-wrong-book]');
    const siteBase = root?.dataset.siteBase ?? '';
    const storageKey = 'zhijian-math-two-wrong';
    const assistantBatchStorageKey = 'zhijian-math-two-assistant-batches';
    const repeatStorageKey = 'zhijian-math-two-repeat-wrong';
    const reviewStorageKey = 'zhijian-math-two-review-answers';
    const reviewSubjectiveStorageKey = 'zhijian-math-two-review-subjective-answers';
    const list = root?.querySelector<HTMLElement>('[data-wrong-list]');
    const empty = root?.querySelector<HTMLElement>('[data-wrong-empty]');
    const count = root?.querySelector<HTMLElement>('[data-wrong-count]');
    const yearNav = root?.querySelector<HTMLElement>('[data-wrong-year-nav]');
    const allButton = root?.querySelector<HTMLButtonElement>('[data-view-all]');
    const repeatButton = root?.querySelector<HTMLButtonElement>('[data-view-repeat]');
    const allCount = root?.querySelector<HTMLElement>('[data-count-all]');
    const repeatCount = root?.querySelector<HTMLElement>('[data-count-repeat]');
    let viewMode: 'all' | 'repeat' = new URLSearchParams(window.location.search).get('tier') === '2' ? 'repeat' : 'all';

    const readKeys = (): string[] => {
      try {
        const value = JSON.parse(localStorage.getItem(storageKey) ?? '[]');
        return Array.isArray(value) ? value.filter((item): item is string => typeof item === 'string') : [];
      } catch {
        return [];
      }
    };

    const saveKeys = (keys: string[]) => {
      try { localStorage.setItem(storageKey, JSON.stringify(keys)); } catch {}
    };

    const readProcessedBatches = (): Set<string> => {
      try {
        const value = JSON.parse(localStorage.getItem(assistantBatchStorageKey) ?? '[]');
        return new Set(Array.isArray(value) ? value.filter((item): item is string => typeof item === 'string') : []);
      } catch {
        return new Set();
      }
    };

    const saveProcessedBatches = (ids: Set<string>) => {
      try { localStorage.setItem(assistantBatchStorageKey, JSON.stringify([...ids])); } catch {}
    };

    const parseKey = (key: string) => {
      const hash = key.indexOf('#');
      const sourcePath = hash >= 0 ? key.slice(0, hash) : key;
      const headingId = hash >= 0 ? key.slice(hash + 1) : '';
      const year = sourcePath.match(/(20\d{2})/)?.[1] ?? '其他';
      return { key, sourcePath, headingId, year };
    };

    const chapterUrl = (sourcePath: string) =>
      `${siteBase}/books/math-two-exams/${sourcePath.replace(/\.(?:md|markdown)$/i, '')}/`;

    const extractQuestion = (doc: Document, headingId: string) => {
      const heading = doc.getElementById(headingId);
      if (!heading || heading.tagName !== 'H3') return null;
      const body = document.createElement('div');
      body.className = 'wrong-question-body';
      let node = heading.nextElementSibling;
      while (node && !['H2', 'H3'].includes(node.tagName)) {
        body.append(node.cloneNode(true));
        node = node.nextElementSibling;
      }
      return { title: heading.textContent?.trim() || '题目', body };
    };

    async function importAssistantWrongBatches(): Promise<string[]> {
      const processed = readProcessedBatches();
      const pending = assistantMathTwoWrongBatches.filter((batch) => !processed.has(batch.id));
      if (!pending.length) return readKeys();

      const keys = new Set(readKeys());
      const years = [...new Set(pending.flatMap((batch) => batch.items.map((item) => item.year)))];
      const documents = new Map<number, Document>();

      await Promise.all(years.map(async (year) => {
        try {
          const response = await fetch(chapterUrl(`chapters/${year}.md`), { cache: 'force-cache' });
          if (!response.ok) return;
          const html = await response.text();
          documents.set(year, new DOMParser().parseFromString(html, 'text/html'));
        } catch {}
      }));

      pending.forEach((batch) => {
        let complete = true;
        batch.items.forEach((item) => {
          const sourceDoc = documents.get(item.year);
          const heading = sourceDoc
            ? [...sourceDoc.querySelectorAll<HTMLElement>('h3[id]')].find((node) =>
                new RegExp(`^第\\s*${item.question}\\s*题(?:\\D|$)`).test(node.textContent?.trim() ?? '')
              )
            : null;
          if (!heading?.id) {
            complete = false;
            return;
          }
          keys.add(`chapters/${item.year}.md#${heading.id}`);
        });
        if (complete) processed.add(batch.id);
      });

      saveKeys([...keys]);
      saveProcessedBatches(processed);
      return [...keys];
    }

    async function renderWrongBook() {
      const keys = await importAssistantWrongBatches();
      list?.replaceChildren();
      yearNav?.replaceChildren();
      if (count) count.textContent = `共 ${keys.length} 道错题`;
      if (empty) empty.hidden = keys.length > 0;
      if (!list || !yearNav) return;

      const entries = keys.map(parseKey);
      const bySource = new Map<string, typeof entries>();
      entries.forEach((entry) => {
        const group = bySource.get(entry.sourcePath) ?? [];
        group.push(entry);
        bySource.set(entry.sourcePath, group);
      });

      const loaded = new Map<string, Document>();
      await Promise.all([...bySource.keys()].map(async (sourcePath) => {
        try {
          const response = await fetch(chapterUrl(sourcePath), { cache: 'force-cache' });
          if (!response.ok) return;
          const html = await response.text();
          loaded.set(sourcePath, new DOMParser().parseFromString(html, 'text/html'));
        } catch {}
      }));

      const updateCounters = () => {
        const active = new Set(readKeys());
        const repeat = readPracticeIds(repeatStorageKey);
        const allTotal = entries.filter((entry) => active.has(entry.key)).length;
        const repeatTotal = entries.filter((entry) => active.has(entry.key) && repeat.has(entry.key)).length;
        if (allCount) allCount.textContent = String(allTotal);
        if (repeatCount) repeatCount.textContent = String(repeatTotal);
        if (count) count.textContent = viewMode === 'repeat'
          ? '二重错题共 ' + repeatTotal + ' 道' : '共 ' + allTotal + ' 道错题';
        allButton?.classList.toggle('is-active', viewMode === 'all');
        repeatButton?.classList.toggle('is-active', viewMode === 'repeat');
        allButton?.setAttribute('aria-pressed', String(viewMode === 'all'));
        repeatButton?.setAttribute('aria-pressed', String(viewMode === 'repeat'));
      };

      const renderView = () => {
        list?.replaceChildren();
        yearNav?.replaceChildren();
        const active = new Set(readKeys());
        const repeat = readPracticeIds(repeatStorageKey);
        const visible = entries
          .filter((entry) => active.has(entry.key) && (viewMode === 'all' || repeat.has(entry.key)))
          .sort((a, b) => Number(a.year) - Number(b.year) || a.key.localeCompare(b.key, 'zh-CN', { numeric: true }));
        updateCounters();
        if (empty) {
          empty.hidden = visible.length > 0;
          empty.textContent = viewMode === 'repeat'
            ? '还没有二重错题。选择题自动判错，主观题可通过 ✗ 做错了自行标记。'
            : '还没有数学二错题。回到数学二真题页作答或手动标记错题即可。';
        }
        if (!visible.length || !list || !yearNav) return;
        const sections = new Map<string, HTMLElement>();
        const years = [...new Set(visible.map((entry) => entry.year))].sort((a, b) => Number(a) - Number(b));
        years.forEach((year, index) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'wrong-year-button';
          button.textContent = year;
          button.dataset.year = year;
          if (index === 0) button.classList.add('is-active');
          button.addEventListener('click', () => {
            yearNav.querySelectorAll('.wrong-year-button').forEach((item) => item.classList.toggle('is-active', item === button));
            sections.get(year)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          yearNav.append(button);
          const section = document.createElement('section');
          section.className = 'wrong-year-section';
          section.dataset.yearSection = year;
          const h2 = document.createElement('h2');
          h2.className = 'wrong-year-heading';
          h2.textContent = year + ' 年';
          section.append(h2);
          sections.set(year, section);
          list.append(section);
        });

        visible.forEach((entry) => {
          const sourceDoc = loaded.get(entry.sourcePath);
          const extracted = sourceDoc ? extractQuestion(sourceDoc, entry.headingId) : null;
          const section = sections.get(entry.year);
          if (!section) return;

          const article = document.createElement('article');
          article.className = 'wrong-question';
          article.dataset.wrongKey = entry.key;
          const head = document.createElement('div');
          head.className = 'wrong-question-head';
          const title = document.createElement('h3');
          title.textContent = extracted?.title ?? entry.headingId;

          const actions = document.createElement('div');
          actions.className = 'wrong-question-actions';
          const source = document.createElement('a');
          source.href = chapterUrl(entry.sourcePath) + '#' + encodeURIComponent(entry.headingId);
          source.textContent = '回原题';
          const remove = document.createElement('button');
          remove.type = 'button';
          remove.textContent = '移出错题';
          remove.addEventListener('click', () => {
            saveKeys(readKeys().filter((key) => key !== entry.key));
            const nextRepeat = readPracticeIds(repeatStorageKey);
            nextRepeat.delete(entry.key);
            savePracticeIds(repeatStorageKey, nextRepeat);
            renderView();
          });
          actions.append(source, remove);
          head.append(title, actions);
          article.append(head);

          let hasChoicePractice = false;
          if (extracted) {
            article.append(extracted.body);
            const optionsEnd = findMathChoiceEnd([...extracted.body.children]);
            const questionNumber = Number(extracted.title.match(/^第\s*(\d+)\s*题/)?.[1]);
            if (optionsEnd && Number.isInteger(questionNumber)) {
              hasChoicePractice = true;
              article.append(createChoicePractice({
                id: entry.key,
                answer: getMathTwoChoiceAnswer(Number(entry.year), questionNumber),
                answerStorageKey: reviewStorageKey,
                wrongStorageKey: storageKey,
                repeatStorageKey,
                onGraded: updateCounters
              }));
            }
          } else {
            const fallback = document.createElement('p');
            fallback.className = 'wrong-question-body';
            fallback.textContent = '题面加载失败，可点“回原题”查看。';
            article.append(fallback);
          }
          if (extracted && !hasChoicePractice) {
            const writtenQuestion = Number(extracted.title.match(/^第\s*(\d+)\s*题/)?.[1]);
            const reference = getMathTwoWrittenAnswerReference(Number(entry.year), writtenQuestion);
            article.append(createSubjectivePractice({
              id: entry.key,
              resultStorageKey: reviewSubjectiveStorageKey,
              wrongStorageKey: storageKey,
              repeatStorageKey,
              reference: reference ? {
                ...reference,
                note: '图片来自第三方考研数学真题整理，未经本站逐题校对，仅供自查。'
              } : undefined,
              onGraded: updateCounters
            }));
          }
          section.append(article);
        });
      };

      const changeView = (next: 'all' | 'repeat') => {
        viewMode = next;
        const url = new URL(window.location.href);
        if (next === 'repeat') url.searchParams.set('tier', '2');
        else url.searchParams.delete('tier');
        window.history.replaceState(null, '', url);
        renderView();
      };
      allButton?.addEventListener('click', () => changeView('all'));
      repeatButton?.addEventListener('click', () => changeView('repeat'));
      renderView();
    }

    void renderWrongBook();
  </script>
</ReaderLayout>
